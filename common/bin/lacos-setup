#!/usr/bin/env bash
# lacos setup — the 2nd-boot wizard. Interviews the box for site particulars
# ("Do you have Tailscale? A home DNS?") and applies them. Idempotent +
# re-runnable. Run as an admin; uses sudo for system changes. Non-secret answers
# persist to /etc/lava-chicken/site.conf. See docs/SETUP-WIZARD.md.
set -uo pipefail

SITE=/etc/lava-chicken/site.conf
STAMP=/etc/lava-chicken/setup.done
STATE=/var/lib/lava-chicken
# shellcheck source=/dev/null
[ -r "$SITE" ] && . "$SITE" 2>/dev/null || true      # prefill prior answers

TUI=""; command -v whiptail >/dev/null 2>&1 && TUI=whiptail
say() { echo "[setup] $*"; }

ask_yesno() { # $1 prompt -> 0 yes / 1 no
  if [ -n "$TUI" ]; then whiptail --title "LaCOS setup" --yesno "$1" 10 72
  else read -r -p "$1 [y/N] " a; [[ "${a:-}" =~ ^[Yy] ]]; fi
}
ask() { # $1 prompt  $2 default -> echoes value
  if [ -n "$TUI" ]; then whiptail --title "LaCOS setup" --inputbox "$1" 10 72 "${2:-}" 3>&1 1>&2 2>&3
  else read -r -p "$1 [${2:-}]: " a; echo "${a:-${2:-}}"; fi
}
save() { # key value -> persist non-secret answer
  sudo install -d -m0755 /etc/lava-chicken
  sudo sed -i "/^$1=/d" "$SITE" 2>/dev/null || true
  printf '%s=%q\n' "$1" "$2" | sudo tee -a "$SITE" >/dev/null
}
valid_dns_name() { # strict, unqualified-trailing-dot-free DNS name
  local name="$1" label
  local -a labels
  [[ -n "$name" && ${#name} -le 253 && "$name" == *.* ]] || return 1
  [[ "$name" != .* && "$name" != *. ]] || return 1
  IFS=. read -r -a labels <<<"$name"
  for label in "${labels[@]}"; do
    [[ -n "$label" && ${#label} -le 63 ]] || return 1
    [[ "$label" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] || return 1
  done
}
is_tailnet_address() { # Tailscale IPv4 CGNAT or stable IPv6 ULA prefix
  local address="${1,,}" second
  if [[ "$address" =~ ^100\.([0-9]{1,3})\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
    second="${BASH_REMATCH[1]}"
    (( 10#$second >= 64 && 10#$second <= 127 ))
  else
    [[ "$address" == fd7a:115c:a1e0:* ]]
  fi
}
address_routes_over_tailnet() {
  local address="$1" route
  is_tailnet_address "$address" || return 1
  if [[ "$address" == *:* ]]; then
    route="$(ip -6 route get "$address" 2>/dev/null || true)"
  else
    route="$(ip -4 route get "$address" 2>/dev/null || true)"
  fi
  [[ " $route " == *" dev tailscale0 "* ]]
}
name_routes_over_tailnet() { # system DNS answer must use the Tailscale interface
  local name="$1" address ignored found=false
  while read -r address ignored; do
    [ -n "$address" ] || continue
    address_routes_over_tailnet "$address" || return 1
    found=true
  done < <(getent ahosts "$name" 2>/dev/null)
  "$found"
}
verify_tailnet_https_origin() { # inspect each redirect before following it
  local host="$1" url result effective remote_ip status redirect hop
  url="https://${host}/"
  for ((hop = 0; hop <= 5; hop++)); do
    result="$(curl --fail --silent --show-error --max-time 15 \
      --proto '=https' --noproxy '*' --output /dev/null \
      --write-out $'%{url_effective}\t%{remote_ip}\t%{http_code}\t%{redirect_url}' \
      "$url")" || return 1
    IFS=$'\t' read -r effective remote_ip status redirect <<<"$result"
    [[ "$effective" == "https://${host}/"* ]] || return 1
    address_routes_over_tailnet "$remote_ip" || return 1
    case "$status" in
      2??) return 0 ;;
      3??)
        [[ "$redirect" == "https://${host}/"* ]] || return 1
        url="$redirect"
        ;;
      *) return 1 ;;
    esac
  done
  return 1
}

sudo -v || { echo "This wizard needs sudo — run it as an admin." >&2; exit 1; }
say "LaCOS setup — configure this box's particulars. Ctrl-C to bail; safe to re-run."
setup_ready=true

# 1) name -------------------------------------------------------------------
NAME="$(ask "Machine / agent name?" "${LAVA_BOX_NAME:-$(hostname)}")"
[ -n "$NAME" ] && { sudo hostnamectl set-hostname "$NAME" 2>/dev/null && say "hostname -> $NAME"; save LAVA_BOX_NAME "$NAME"; }

# 2) admin SSH keys from GitHub --------------------------------------------
GH="$(ask "GitHub username for admin SSH keys (blank to skip)?" "${LAVA_GH_USER:-}")"
if [ -n "$GH" ]; then
  keys="$(curl -fsSL "https://github.com/${GH}.keys" 2>/dev/null || true)"
  if [ -n "${keys//[$'\n\r\t ']/}" ]; then
    sudo install -d -m0700 -o "$USER" -g "$USER" "$HOME/.ssh"
    b="# >>> lava-chicken github:${GH} >>>"; e="# <<< lava-chicken github:${GH} <<<"
    tmp="$(mktemp)"; touch "$HOME/.ssh/authorized_keys"
    awk -v b="$b" -v e="$e" '$0==b{s=1} !s{print} $0==e{s=0}' "$HOME/.ssh/authorized_keys" >"$tmp"
    { echo "$b"; echo "$keys"; echo "$e"; } >>"$tmp"
    install -m0600 "$tmp" "$HOME/.ssh/authorized_keys"; rm -f "$tmp"
    say "admin SSH keys refreshed from github.com/$GH"
  else say "no keys at github.com/$GH — skipped"; fi
  save LAVA_GH_USER "$GH"
fi

# 3) Tailscale? -------------------------------------------------------------
if ask_yesno "Do you use Tailscale (mesh VPN / remote access)?"; then
  tailscale_ok=false
  if ! command -v tailscale >/dev/null 2>&1; then
    say "installing tailscale ..."
    sudo rpm-ostree install --apply-live --idempotent tailscale 2>/dev/null \
      || { curl -fsSL https://tailscale.com/install.sh | sudo sh; } \
      || say "couldn't install tailscale automatically — see https://tailscale.com/download/linux"
    sudo systemctl enable --now tailscaled 2>/dev/null || true
  fi
  if command -v tailscale >/dev/null 2>&1; then
    # Bazzite SHIPS tailscale with the daemon disabled — `tailscale up` fails
    # without this (hardware-day finding, #30).
    sudo systemctl enable --now tailscaled 2>/dev/null || true
    # Keep Tailscale DNS enabled. Household zones belong in Tailscale split DNS
    # (and the local resolver route below), rather than disabling MagicDNS.
    tailscale_enrolled=false
    if ! tailscale status --peers=false >/dev/null 2>&1 \
      || ! tailscale ip -4 >/dev/null 2>&1; then
      say "Follow the login URL Tailscale prints; this wizard never accepts an auth key:"
      sudo tailscale up || true
    fi
    if tailscale status --peers=false >/dev/null 2>&1 \
      && tailscale ip -4 >/dev/null 2>&1 \
      && sudo tailscale set --accept-routes=true --accept-dns=true --hostname="$NAME"; then
      tailscale_enrolled=true
    fi

    if "$tailscale_enrolled" \
      && tailscale ip -4 >/dev/null 2>&1 \
      && sudo tailscale dns status >/dev/null 2>&1; then
      tailscale_ok=true
      say "joined the tailnet as $NAME; Tailscale DNS acceptance verified"
    else
      say "Tailscale enrollment or DNS verification failed; not recording this step as ready."
    fi
  fi

  if "$tailscale_ok"; then
    save LAVA_TAILSCALE yes
    say "Keep Authentik on one canonical, private, Tailscale-resolved HTTPS name."
    auth_fqdn="$(ask "Canonical Authentik FQDN to verify (blank if not deployed yet)?" "${LAVA_AUTHENTIK_FQDN:-}")"
    if [ -n "$auth_fqdn" ]; then
      auth_fqdn="${auth_fqdn,,}"
      if valid_dns_name "$auth_fqdn" \
        && [[ "$auth_fqdn" != "home.lab" && "$auth_fqdn" != *".home.lab" ]] \
        && sudo tailscale dns query -- "$auth_fqdn" >/dev/null 2>&1 \
        && name_routes_over_tailnet "$auth_fqdn" \
        && verify_tailnet_https_origin "$auth_fqdn"; then
        save LAVA_AUTHENTIK_FQDN "$auth_fqdn"
        say "canonical Authentik tailnet DNS and HTTPS verified"
      else
        save LAVA_AUTHENTIK_FQDN ""
        setup_ready=false
        say "Authentik verification failed; do not configure Google or OIDC clients yet."
      fi
    fi
  else
    save LAVA_TAILSCALE pending
    setup_ready=false
  fi
else save LAVA_TAILSCALE no; fi

# 4) home DNS? --------------------------------------------------------------
if ask_yesno "Do you have a home DNS / custom LAN domain (e.g. home.arpa)?"; then
  dom="$(ask "LAN domain?" "${LAVA_LAN_DOMAIN:-home.arpa}")"
  dom="${dom,,}"
  dns="$(ask "DNS server IP that serves $dom?" "${LAVA_LAN_DNS:-}")"
  dns_route_ok=false
  if [[ "$dns" == *:* ]]; then
    ip -6 route get "$dns" >/dev/null 2>&1 && dns_route_ok=true
  elif [ -n "$dns" ]; then
    ip -4 route get "$dns" >/dev/null 2>&1 && dns_route_ok=true
  fi
  if valid_dns_name "$dom" \
    && [[ "$dom" != "ts.net" && "$dom" != *".ts.net" ]] \
    && "$dns_route_ok"; then
    dns_tmp="$(mktemp)" || dns_tmp=""
    dns_configured=false
    if [ -n "$dns_tmp" ] \
      && printf '[Resolve]\nDNS=%s\nDomains=~%s\n' "$dns" "$dom" >"$dns_tmp" \
      && sudo install -d -m0755 /etc/systemd/resolved.conf.d \
      && sudo install -m0644 "$dns_tmp" \
        /etc/systemd/resolved.conf.d/10-lava-chicken-lan.conf \
      && sudo systemctl restart systemd-resolved 2>/dev/null; then
      dns_configured=true
    fi
    [ -z "$dns_tmp" ] || rm -f "$dns_tmp"
    if "$dns_configured" \
      && save LAVA_LAN_DOMAIN "$dom" \
      && save LAVA_LAN_DNS "$dns"; then
      say "split-DNS: *.$dom -> $dns"
      say "ACTION in the Tailscale DNS console: add split DNS for $dom -> $dns so every tailnet client agrees."
      say "The DNS server must be a tailnet node or reachable through an approved subnet route/grant; test it from an off-LAN tailnet client."
      say "ACTION on your DNS server (e.g. dnsmasq): add  address=/$NAME.$dom/<this box's IP>"
    else
      setup_ready=false
      say "couldn't apply and record the LAN split-DNS route; fix systemd-resolved and re-run setup."
    fi
  else
    setup_ready=false
    say "invalid or unreachable LAN domain/DNS server; existing resolver configuration was left unchanged."
  fi
else
  if sudo rm -f /etc/systemd/resolved.conf.d/10-lava-chicken-lan.conf \
    && sudo systemctl restart systemd-resolved 2>/dev/null \
    && save LAVA_LAN_DOMAIN "" \
    && save LAVA_LAN_DNS ""; then
    say "LaCOS LAN split-DNS is disabled"
  else
    setup_ready=false
    say "couldn't remove and record the LAN split-DNS route; saved LAN state was left unchanged where possible."
  fi
fi

# 5) WireGuard streaming? ---------------------------------------------------
if ask_yesno "Use WireGuard for low-latency game streaming (Sunshine/Moonlight)?"; then
  say "On your WG hub, add this box as a peer (e.g. wg-add-peer.sh)."
  say "Sunshine is already running — pair Moonlight at https://$NAME:47990"
  save LAVA_WIREGUARD yes
fi

# 6) kid accounts (#30: was spec'd but never implemented) --------------------
if ask_yesno "Set up kid accounts (passwordless local users, no admin rights)?"; then
  kids="$(ask "Kid usernames (space-separated, e.g. 'kid1 kid2')?" "${LAVA_KID_USERS:-}")"
  if [ -n "$kids" ]; then
    auto="$(ask "Which one auto-logs-in at boot?" "${kids%% *}")"
    PROV=/usr/share/lava-chicken/provision; [ -d "$PROV" ] || PROV="$STATE/provision"
    if sudo LAVA_KID_USERS="$kids" LAVA_AUTOLOGIN_USER="$auto" bash "$PROV/30-users.sh"; then
      say "kid accounts ready: $kids (autologin: $auto)"
    else
      setup_ready=false
      say "kid-account step failed — re-run: sudo LAVA_KID_USERS='$kids' bash $PROV/30-users.sh"
    fi
    save LAVA_KID_USERS "$kids"; save LAVA_AUTOLOGIN_USER "$auto"
  fi
fi

# 7) models -----------------------------------------------------------------
# The box needs a chat model + embeddings before nugget/newt can answer. Let the
# operator confirm the set, persist it, ensure ollama is up, and pull now.
MODELS="$(ask "LLM model set to pull (space-separated: chat model + embeddings)?" \
  "${LAVA_MODELS:-qwen2.5-coder:7b nomic-embed-text}")"
if [ -n "${MODELS// /}" ]; then
  printf '%s\n' $MODELS | sudo tee /etc/lava-chicken/models.conf >/dev/null
  save LAVA_MODELS "$MODELS"
  if ask_yesno "Pull now via ollama? (~5 GB; skip to pull later with 'lacos models')  $MODELS"; then
    sudo systemctl enable --now ollama.service 2>/dev/null || true
    if lacos models; then say "models ready: $MODELS"
    else say "model pull hit a snag — retry later: 'lacos models' or 'sudo lacos doctor --fix'"; fi
  else
    say "skipped — pull later with: lacos models"
  fi
fi

if "$setup_ready"; then
  date -u +%FT%TZ | sudo tee "$STAMP" >/dev/null
  say "✓ setup complete. Answers saved to $SITE — re-run 'lacos setup' any time."
else
  sudo rm -f "$STAMP"
  say "Setup is incomplete, so the completion stamp was not written. Fix the reported step and re-run 'lacos setup'."
  exit 1
fi
